<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Points at our own release manifest, generated and attached by release.yml on every
        release. /releases/latest/download/ is GitHub's built-in "always the newest non-draft,
        non-prerelease release" redirect - no moving tag to maintain, unlike upstream's scheme.

        AppVersionChecker compares versionCode, not versionName - release.yml bumps versionCode
        to the release date (YYYYMMDD) on every run specifically so this comparison means
        something. See docs/ROADMAP.md if that ever needs revisiting.
    -->
    <string-array name="update_urls">
        <item>https://github.com/abhimanbhau/AetherTube/releases/latest/download/update_manifest.json</item>
    </string-array>
</resources>
