<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        BETA CHANNEL. Deliberately NOT /releases/latest/download/ like the stable flavor uses - that
        redirect resolves to the newest *non-prerelease* release, which is exactly what keeps stable
        users from ever being offered a beta build. The flip side is that it can never point at a
        beta, so beta installs need a fixed address of their own.

        beta-latest is a rolling tag: CI.yml deletes and recreates it on every push to master, so
        this URL always serves the newest beta manifest without anything here needing to change.

        The two channels are separate apps (applicationId .beta vs .stable), so they update
        independently and neither can overwrite the other.
    -->
    <string-array name="update_urls">
        <item>https://github.com/abhimanbhau/AetherTube/releases/download/beta-latest/update_manifest.json</item>
    </string-array>
</resources>
